name: Analytics Dashboard & Nurture Pipeline

on:
  schedule:
    # Run every 3 hours during market hours
    - cron: '0 */3 * * 1-5'
  workflow_dispatch:

permissions:
  contents: write
  pages: write
  id-token: write

jobs:
  analytics:
    runs-on: ubuntu-latest
    timeout-minutes: 10

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
        with:
          persist-credentials: true

      - name: Setup Python 3.11
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'
          cache: 'pip'

      - name: Install dependencies
        run: |
          pip install --upgrade pip
          pip install requests

      - name: Scan interactions & update pipeline
        env:
          THREADS_ACCESS_TOKEN: ${{ secrets.THREADS_ACCESS_TOKEN }}
          BLUESKY_HANDLE: ${{ secrets.BLUESKY_HANDLE }}
          BLUESKY_APP_PASSWORD: ${{ secrets.BLUESKY_APP_PASSWORD }}
          TELEGRAM_BOT_TOKEN: ${{ secrets.TELEGRAM_BOT_TOKEN }}
          GROQ_API_KEY: ${{ secrets.GROQ_API_KEY }}
        run: |
          python customer_nurture.py --scan

      - name: Generate dashboard data
        run: |
          python dashboard_api.py --days 30 -o data.json

      - name: Build standalone dashboard
        run: |
          python -c "
          import json
          with open('dashboard.html', encoding='utf-8') as f: html = f.read()
          with open('data.json', encoding='utf-8') as f: data = json.load(f)
          html = html.replace('</head>', '<script>window.__DATA__=' + json.dumps(data) + ';</script>\n</head>')
          with open('dashboard_standalone.html', 'w', encoding='utf-8') as f: f.write(html)
          print('Dashboard built')
          "

      - name: Commit & push updates
        if: always()
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          git config user.name "BroadFSC Bot"
          git config user.email "bot@broadfsc.com"
          git add analytics.db data.json dashboard_standalone.html .bot_memory/ || true
          git diff --staged --quiet || git commit -m "chore(analytics): dashboard refresh + nurture cycle [skip ci]"
          git push https://x-access-token:${GH_TOKEN}@github.com/msli2233bin/broadfsc-automation.git HEAD:main
