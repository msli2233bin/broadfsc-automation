name: Daily Hatena Blog Auto-Post

on:
  schedule:
    # Daily at 09:00 Beijing time (01:00 UTC)
    - cron: '0 1 * * *'
  workflow_dispatch: # Manual trigger
  push:
    branches: [ main ]
    paths:
      - 'hatena_poster.py'
      - '.github/workflows/hatena_posting.yml'

jobs:
  post:
    runs-on: ubuntu-latest
    timeout-minutes: 15

    steps:
    - name: Checkout code
      uses: actions/checkout@v4

    - name: Set up Python
      uses: actions/setup-python@v5
      with:
        python-version: '3.11'

    - name: Install dependencies
      run: |
        python -m pip install --upgrade pip
        pip install groq yfinance requests

    - name: Generate & Post to Hatena Blog
      env:
        GROQ_API_KEY: ${{ secrets.GROQ_API_KEY }}
        BREVO_API_KEY: ${{ secrets.BREVO_API_KEY }}
        BREVO_SENDER_EMAIL: ${{ secrets.BREVO_SENDER_EMAIL }}
        HATENA_POST_EMAIL: ${{ secrets.HATENA_POST_EMAIL }}
        HATENA_BLOG_DOMAIN: ${{ secrets.HATENA_BLOG_DOMAIN }}
      run: |
        python hatena_poster.py

    - name: Send Telegram Notification
      if: always()
      env:
        TELEGRAM_BOT_TOKEN: ${{ secrets.TELEGRAM_BOT_TOKEN }}
        TELEGRAM_CHAT_ID: ${{ secrets.TELEGRAM_CHAT_ID }}
      run: |
        STATUS="${{ job.status }}"
        if [ "$STATUS" = "success" ]; then
          MSG="✅ Hatena blog posted! $(date +'%Y-%m-%d')"
        else
          MSG="❌ Hatena post failed! Check: https://github.com/${{ github.repository }}/actions/runs/${{ github.run_id }}"
        fi
        curl -s -X POST "https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/sendMessage" \
          -d "chat_id=${TELEGRAM_CHAT_ID}&text=${MSG}" || true
